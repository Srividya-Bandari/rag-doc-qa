OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
EMBEDDING_BATCH_SIZE=64
TOP_K=5
